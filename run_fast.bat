@echo off
chcp 1251 >nul
REM ============================================================
REM  DreamBreaker - запуск игры
REM ============================================================
REM  Двойной клик запускает игру.
REM  Если БД ещё не настроена - сначала запусти setup_db.bat.
REM ============================================================

REM Проверяем, была ли выполнена первоначальная настройка.
if not exist .env (
    echo ============================================================
    echo  Похоже, игра ещё не настроена — файл .env не найден.
    echo  Сначала запусти setup_db.bat для настройки базы данных.
    echo ============================================================
    pause >nul
    exit /b 1
)

echo Запуск DreamBreaker...
echo.
cargo run --release
echo.
REM Консоль закроется автоматически после завершения cargo run