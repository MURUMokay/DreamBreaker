@echo off
chcp 1251 >nul

REM ============================================================
REM  DreamBreaker - сборка релизной версии
REM ============================================================
REM  Создаёт оптимизированный .exe и кладёт рядом .env,
REM  чтобы игру можно было запускать двойным кликом.
REM ============================================================

echo Сборка релизной версии DreamBreaker...
echo Это может занять несколько минут при первой сборке.
echo.

cargo build --release

if %ERRORLEVEL% neq 0 (
    echo.
    echo !!! Ошибка сборки. Смотри сообщения выше.
    pause >nul
    exit /b 1
)

REM Копируем .env рядом с .exe, чтобы он нашёлся при двойном клике.
if exist .env (
    copy /Y .env target\release\.env >nul
    xcopy /E /Y assets target\release\assets\
    echo .env скопирован рядом с exe.
) else (
    echo ВНИМАНИЕ: файл .env не найден. Создай его перед запуском .exe.
)

echo.
echo ============================================================
echo  Готово! Исполняемый файл:
echo  target\release\dreambreaker.exe
echo.
echo  Запускать двойным кликом (нужен работающий PostgreSQL).
echo ============================================================
pause >nul
